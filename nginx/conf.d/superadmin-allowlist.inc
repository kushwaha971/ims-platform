# nginx/conf.d/superadmin-allowlist.inc — generated by ops from
# SUPERADMIN_IP_ALLOWLIST (.env). Included inside `location /api/v1/admin/`,
# immediately before `deny all`, so an EMPTY FILE FAILS CLOSED: nobody reaches
# the super-admin surface until an operator puts their CIDR here.
#
# Regenerate:
#   for cidr in ${SUPERADMIN_IP_ALLOWLIST//,/ }; do echo "allow $cidr;"; done \
#     > nginx/conf.d/superadmin-allowlist.inc
#   docker compose exec nginx nginx -s reload
#
# Example (do not ship uncommented):
# allow 203.0.113.7/32;
# allow 198.51.100.0/24;
