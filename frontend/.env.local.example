# Part 19 §19.14.1 — only NEXT_PUBLIC_* reaches the browser, and the list is
# deliberately tiny. Branding, modules, flags and limits come from GET /auth/me
# at runtime, because those are per tenant, not per build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=YourKhata
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_ANALYTICS_ENABLED=true
# DEC-017 — PostHog (analytics and feedback). Both are needed for anything to be
# sent: the flag above set to true, and the project key here. The key is a
# public one by design. Leave the flag false on a developer's machine.
NEXT_PUBLIC_POSTHOG_KEY=phc_snjs6biUJMuJyF9UiKPMZepvUtHCLRG3asvDqPrtmrzu
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_DEFAULTS=2026-05-30
# Session replay shows the words on screen. true = every word becomes asterisks.
# What a person types is never recorded either way.
NEXT_PUBLIC_POSTHOG_REPLAY_MASK_TEXT=false
NEXT_PUBLIC_SW_ENABLED=true
NEXT_PUBLIC_COMMIT_SHA=dev
# Canonical origin for SEO (canonical, og:image, robots, sitemap). Defaults to https://yourkhata.com.
NEXT_PUBLIC_SITE_URL=https://yourkhata.com
# Search-engine ownership codes (not secrets). Paste the code from Google Search
# Console ("HTML tag" method) and Bing Webmaster Tools; empty writes no tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Where the demo film files are served from (no trailing slash). The films are
# in git under public/media/landing; point this at a CDN folder to serve them
# from there instead.
NEXT_PUBLIC_DEMO_VIDEO_BASE_URL=/media/landing
# Modules the landing page does not show (empty shows them all).
NEXT_PUBLIC_LANDING_HIDDEN_MODULES=gym,hotel

# The demo film on YouTube, one video id per cut. With an id, play loads YouTube's
# player; empty, the file under public/media/landing plays. Defaults are in
# src/constants.ts (desktop: fk-hjhDi-tg; phone: none until it can be embedded).
NEXT_PUBLIC_DEMO_YOUTUBE_DESKTOP=fk-hjhDi-tg
# Empty on purpose until the corrected phone recording is on YouTube: an empty
# id plays our own file. Put the 11-character video id here.
NEXT_PUBLIC_DEMO_YOUTUBE_MOBILE=

# Server-side only: the compose proxy target for the same-origin rewrite.
API_PROXY_TARGET=http://backend:8000
