    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "decimal.js-light": "^2.5.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.475.0",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.54.2",
    "react-intl": "^7.1.6",
    "react-redux": "^9.2.0",
