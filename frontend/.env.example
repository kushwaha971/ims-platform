# Public browser configuration only. Copy to .env.local for native development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
API_PROXY_TARGET=http://localhost:8000
NEXT_PUBLIC_APP_NAME=YourKhata
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_SITE_URL=https://yourkhata.com
NEXT_PUBLIC_COMMIT_SHA=dev
NEXT_PUBLIC_SW_ENABLED=false
NEXT_PUBLIC_OTP_PROVIDER=meta_whatsapp
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Public project/measurement IDs; never private API secrets.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_DEFAULTS=2026-05-30
NEXT_PUBLIC_POSTHOG_REPLAY_MASK_TEXT=true
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_DEMO_VIDEO_BASE_URL=/media/landing
NEXT_PUBLIC_DEMO_YOUTUBE_DESKTOP=
NEXT_PUBLIC_DEMO_YOUTUBE_MOBILE=
NEXT_PUBLIC_LANDING_HIDDEN_MODULES=gym,hotel
# Optional HTML ownership methods. DNS-verified Search Console needs no meta token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Railway: use /api/v1 and production, and pass public values as Docker build args.
# Keep database, Meta, OTP pepper and signing keys in backend variables only.
