# Build artefacts
build/
dist/
.next/
out/
node_modules/
# A symlink named node_modules (worktrees link to the main checkout's) is a file, not a
# directory, so the pattern above misses it; this one catches both.
node_modules
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Env & secrets
.env
.env.*
!.env.example
!.env.local.example

# Local media & backups
media/
backups/

# The landing page's silent loops, their posters and manifest.json are part of
# the page and ARE tracked, so `media/` above is undone for exactly that one
# folder (git cannot re-include a file under an excluded directory, hence the
# three steps: the folder, nothing else in it, then landing/).
!/frontend/public/media/
/frontend/public/media/*
!/frontend/public/media/landing/
# The narrated demo films (and their captions and posters) stay OUT of git, by
# the owner's decision: they are 10-16 MB each, re-cut often, and served from
# NEXT_PUBLIC_DEMO_VIDEO_URL_* in production. The modal copes with their absence.
/frontend/public/media/landing/demo-*
*.dump

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Transfer artefacts
_transfer.tar.gz

# The vendored ml-uikit's compiled output IS the package — `dist/` above would
# otherwise drop it, leaving a `file:` dependency pointing at two metadata files
# and a build that fails everywhere except the machine it was vendored on. Its
# own node_modules stays ignored: npm installs the library's dependencies there
# when it links a file: dependency, and that is 71 MB of other people's packages
# that `npm ci` recreates from the lockfile.
!/frontend/vendor/ml-uikit/dist/
/frontend/vendor/*/node_modules/
.claude/worktrees/
