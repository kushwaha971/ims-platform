# =============================================================================
# YourKhata — environment catalogue (yourkhata.com)
# =============================================================================
# This file IS the normative catalogue of Part 29 §29.2.4, in order, with those
# defaults. One file per host: `cp .env.example .env`, then `chmod 600 .env`.
# .env is never committed.
#
# Naming convention (§29.2.4): every variable the APPLICATION reads is prefixed
# UB_. Variables consumed by a third-party image or tool keep the name that tool
# requires and are never prefixed — DJANGO_SETTINGS_MODULE, POSTGRES_*,
# DATABASE_URL, PG_*, GUNICORN_*, NEXT_PUBLIC_* / INTERNAL_API_BASE_URL,
# BACKUP_* and SUPERADMIN_IP_ALLOWLIST.
#
# Settings modules are config.settings.{local,staging,prod,test} and nothing else.
#
# Lines marked  # SECRET  are deliberately blank. Fill them in .env, never here.
# Generate the two required ones with:
#   python3 -c "import secrets; print('UB_SECRET_KEY=' + secrets.token_urlsafe(64))" >> .env
#   python3 -c "import secrets; print('POSTGRES_PASSWORD=' + secrets.token_urlsafe(24))" >> .env
# =============================================================================


# -----------------------------------------------------------------------------
# Application variables (UB_), read by `backend` and `scheduler`
# -----------------------------------------------------------------------------

# Django signing key; also seeds hostname-verification tokens. Rotating it
# invalidates every token and session. REQUIRED — no default.
UB_SECRET_KEY=                                    # SECRET

# Asserted 0 in staging and production.
UB_DEBUG=1

# local / staging / production; stamped on every log line.
UB_ENV_NAME=local

# Comma list; extended at runtime by verified partner hostnames.
# Production example: UB_ALLOWED_HOSTS=yourkhata.com,www.yourkhata.com,backend
UB_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Exact origins; `*` is rejected at startup in production.
# Production example: UB_CORS_ALLOWED_ORIGINS=https://yourkhata.com
UB_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Must include every partner host.
# Production example: UB_CSRF_TRUSTED_ORIGINS=https://yourkhata.com,https://www.yourkhata.com
UB_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ub_access / ub_refresh cookie domain. Empty locally.
UB_COOKIE_DOMAIN=

# 1 in staging and production.
UB_COOKIE_SECURE=0

# Absolute URLs in share links, documents and messages. NEVER taken from the Host header.
# Production example: UB_PUBLIC_BASE_URL=https://yourkhata.com
UB_PUBLIC_BASE_URL=http://localhost:3000

UB_API_BASE_PATH=/api/v1

# Seconds; persistent connections. 0 disables.
UB_DB_CONN_MAX_AGE=60

# Per-connection statement_timeout / lock_timeout (Part 20 §20.11.2).
UB_DB_STATEMENT_TIMEOUT_MS=15000
UB_DB_LOCK_TIMEOUT_MS=5000

# ADR-011.
# PLT-05 FR-11 — how long an invitation stays acceptable. A partner onboarding a
# cohort in person wants hours, not the week the specification names, and that
# should not need a deploy.
UB_INVITATION_DAYS=7
UB_ACCESS_TOKEN_MINUTES=15
UB_REFRESH_TOKEN_DAYS=30

# Distinct from UB_SECRET_KEY. REQUIRED in production.
UB_OTP_PEPPER=dev-otp-pepper                      # SECRET in staging/production
UB_OTP_TTL_SECONDS=300
UB_OTP_MAX_ATTEMPTS=5

# Dotted paths (ADR-015).
UB_SMS_BACKEND=platform.messaging.backends.ConsoleSmsBackend
UB_SMS_SENDER_ID=UDHAAR
UB_WHATSAPP_BACKEND=platform.messaging.backends.DeepLinkWhatsAppBackend
UB_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Uploads and collectstatic output; both are container paths backed by volumes.
UB_MEDIA_ROOT=/srv/media
UB_STATIC_ROOT=/srv/static
UB_MEDIA_MAX_UPLOAD_MB=10

UB_LOG_LEVEL=INFO
# json everywhere; `console` locally (the local overlay already sets it).
UB_LOG_FORMAT=json
# Rotating file handler target in production.
UB_LOG_DIR=./logs
# Local only; logs every query.
UB_LOG_SQL=0

# Run jobs inline (Part 20 §20.8.10); 1 in the test settings module.
UB_JOBS_EAGER=0

# Seconds between empty-queue polls; jobs claimed per tick; advisory-lock key for
# the periodic-enqueue step ONLY (Part 20 §20.8.6.1 rule S2).
UB_SCHEDULER_INTERVAL=60
UB_SCHEDULER_BATCH=50
UB_SCHEDULER_ENQUEUE_LOCK_ID=918273645

# Part 22 §22.1.
UB_RATE_LIMIT_USER=600/min
UB_RATE_LIMIT_OTP=5/10min
UB_RATE_LIMIT_EXPORT=10/hour
UB_RATE_LIMIT_PARTY_WRITE=60/min

# Business-date boundary; tenant-overridable.
UB_DEFAULT_TIMEZONE=Asia/Kolkata
UB_DEFAULT_LOCALE=en

# Bootstrap only; ignored when UB_ENV_NAME=production.
UB_SUPER_ADMIN_MOBILES=

# Global kill-switches, e.g. {"public_links": false}
UB_FEATURE_FLAGS={}

# Build/commit id, returned by /system/version and stamped on logs.
UB_VERSION=dev

# Enables the test-only OTP endpoint; asserted 0 in production.
UB_E2E_MODE=0

# Local settings only: lifts the shared per-IP sign-up / failed-login / reset
# budgets for e2e/run-regression.mjs. Never read by staging or production.
UB_E2E_RELAX_THROTTLES=0

# X-UB-Partner acceptance; asserted 0 in production (Part 24 §24.3.1).
UB_ALLOW_PARTNER_HEADER=0

# Per-partner messaging credentials referenced by `credentials_ref`
# (Part 24 §24.7.1). Absent ⇒ that channel is `skipped`, never an exception.
# Exempt from the UB_ prefix rule because the suffix is partner data.
# MSG91_METIS=                                    # SECRET
# WA_METIS=                                       # SECRET
# SMTP_METIS=                                     # SECRET


# -----------------------------------------------------------------------------
# Third-party variables, unprefixed by requirement
# -----------------------------------------------------------------------------

# One of config.settings.{local,staging,prod,test}
DJANGO_SETTINGS_MODULE=config.settings.local

POSTGRES_DB=udhaarbook
POSTGRES_USER=udhaarbook
POSTGRES_PASSWORD=                                # SECRET — required, no default
POSTGRES_HOST=db                                  # `db` under compose; 127.0.0.1 natively
POSTGRES_PORT=5432

# Composed by compose from the three above; set it only when pointing at an
# external database or a PgBouncer (§29.10 step 4).
# DATABASE_URL=postgresql://udhaarbook:password@db:5432/udhaarbook   # SECRET

# Postgres server flags, applied by the prod/staging overlays.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=100
PG_SLOW_MS=500

# 2×vCPU+1; worker timeout in seconds.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Browser-side API base — BAKED AT BUILD TIME. Changing it needs a rebuild.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Fallback product name before branding resolves — also a build arg.
NEXT_PUBLIC_APP_NAME=YourKhata
# The public origin search engines know the site by: canonical link, og:image,
# robots.txt and sitemap.xml (CR-2026-09-29-PLATFORM-C). A build arg; a staging
# host sets its own. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://yourkhata.com
# Server-component fetches, runtime.
INTERNAL_API_BASE_URL=http://backend:8000/api/v1

# Backup container (prod/staging overlays only).
BACKUP_DIR=/srv/backups
BACKUP_HOUR_UTC=20
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_WEEKLY=12
# rsync/scp destination for off-host copies, and the SSH key used for it.
BACKUP_REMOTE_TARGET=
BACKUP_REMOTE_KEY=                                # SECRET

# CIDR list permitted to reach /api/v1/admin/ — read by nginx via
# nginx/conf.d/superadmin-allowlist.inc, which ops generates from this value.
SUPERADMIN_IP_ALLOWLIST=


# -----------------------------------------------------------------------------
# Compose build selectors — not application settings, not part of §29.2.4
# -----------------------------------------------------------------------------
# These select a Dockerfile stage and Node's mode. They are read by compose
# itself, never by Django, so they are outside the §29.2.4 catalogue; they are
# listed here because docker-compose.yml interpolates them and the CI
# env-coverage check requires every interpolated name to appear in this file.
BACKEND_TARGET=runtime
FRONTEND_TARGET=runtime
NODE_ENV=production
