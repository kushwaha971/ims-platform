# DigiKhaato backend environment. Copy to `.env` and edit.
# Every variable here is the Part 29 §29.2.4 catalogue, in order, with its
# development default. `.env` is git-ignored; this file is committed and carries
# no secret. Variables the application reads are prefixed `UB_`; variables a
# third-party image requires by name are not.

# ── Identity and posture ──────────────────────────────────────────────────────
UB_SECRET_KEY=dev-insecure-change-me-not-for-production
UB_DEBUG=1
UB_ENV_NAME=local
UB_ALLOWED_HOSTS=localhost,127.0.0.1,backend
UB_CORS_ALLOWED_ORIGINS=http://localhost:3000
UB_CSRF_TRUSTED_ORIGINS=http://localhost:3000
UB_COOKIE_DOMAIN=
UB_COOKIE_SECURE=0
UB_PUBLIC_BASE_URL=http://localhost:3000
UB_API_BASE_PATH=/api/v1
UB_VERSION=dev

# ── Database tuning (the connection itself is POSTGRES_* below) ───────────────
UB_DB_CONN_MAX_AGE=60
UB_DB_STATEMENT_TIMEOUT_MS=15000
UB_DB_LOCK_TIMEOUT_MS=5000

# ── Auth (ADR-011, DEC-010: email + password at MVP) ──────────────────────────
# PLT-05 FR-11 — how long an invitation stays acceptable. A partner onboarding a
# cohort in person wants hours, not the week the specification names.
UB_INVITATION_DAYS=7
UB_ACCESS_TOKEN_MINUTES=15
UB_REFRESH_TOKEN_DAYS=30
# Password reset link: single-use, 15 minutes, hashed at rest (Part 27 §27.4.2).
UB_RESET_TOKEN_TTL_SECONDS=900
# Address verification is plumbed and off; nothing blocks login on it.
UB_EMAIL_VERIFICATION_ENABLED=0
UB_VERIFY_TOKEN_TTL_SECONDS=86400
# Mobile OTP is retired to the backlog. Set to 1 to re-register /auth/otp/*.
UB_AUTH_OTP_ENABLED=0
UB_OTP_PEPPER=dev-otp-pepper
UB_OTP_TTL_SECONDS=300
UB_OTP_MAX_ATTEMPTS=5

# ── Integrations (ADR-015/016) ────────────────────────────────────────────────
UB_SMS_BACKEND=apps.common.integrations.sms.console.ConsoleSmsBackend
UB_SMS_SENDER_ID=UDHAAR
UB_WHATSAPP_BACKEND=apps.common.integrations.whatsapp.deep_link.WaMeBackend
UB_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# The outbound-email adapter (writes `notifications_message_log`). Swap this one
# line for a real provider; nothing else changes.
UB_EMAIL_ADAPTER=apps.common.integrations.email.console.ConsoleEmailBackend
UB_EMAIL_FROM=no-reply@digikhaato.local

# ── Files (ADR-013) ───────────────────────────────────────────────────────────
UB_MEDIA_ROOT=./media
UB_STATIC_ROOT=./staticfiles
UB_MEDIA_MAX_UPLOAD_MB=10

# ── Logging (Part 30) ─────────────────────────────────────────────────────────
UB_LOG_LEVEL=INFO
UB_LOG_FORMAT=console
UB_LOG_DIR=./logs
UB_LOG_SQL=0

# ── Jobs and scheduler (ADR-012, Part 20 §20.8) ───────────────────────────────
UB_JOBS_EAGER=0
UB_SCHEDULER_INTERVAL=60
UB_SCHEDULER_BATCH=50
UB_SCHEDULER_ENQUEUE_LOCK_ID=918273645

# ── Rate limits (Part 22 §22.1) ───────────────────────────────────────────────
UB_RATE_LIMIT_USER=600/min
UB_RATE_LIMIT_OTP=5/10min
UB_RATE_LIMIT_EXPORT=10/hour

# ── Locale ────────────────────────────────────────────────────────────────────
UB_DEFAULT_TIMEZONE=Asia/Kolkata
UB_DEFAULT_LOCALE=en

# ── Bootstrap and flags ───────────────────────────────────────────────────────
UB_SUPER_ADMIN_MOBILES=
UB_FEATURE_FLAGS={}
UB_E2E_MODE=0
UB_ALLOW_PARTNER_HEADER=0
# PLT-01 EC-6 — permits the console SMS backend outside DEBUG (single-user local deploy).
UB_ALLOW_CONSOLE_SMS=0

# ── Third-party variables, unprefixed by requirement ──────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.local
POSTGRES_DB=udhaarbook
POSTGRES_USER=udhaarbook
POSTGRES_PASSWORD=udhaarbook
POSTGRES_HOST=db
POSTGRES_PORT=5432
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
